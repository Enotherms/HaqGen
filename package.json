{
  "name": "haqgen",
  "version": "0.0.1",
  "description": "Decky Loader plugin for Lossless Scaling frame generation on Steam Deck",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enotherms/HaqGen.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "frame-generation"
  ],
  "author": "Enotherms <88973622+Enotherms@users.noreply.github.com>",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.16.5",
    "@rollup/rollup-linux-x64-musl": "^4.59.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.59.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.7.0",
    "tslib": "^2.9.1"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    },
    "overrides": {
      "@rollup/plugin-commonjs": "^29.0.3",
      "@rollup/pluginutils": "^5.3.0"
    }
  }
}
